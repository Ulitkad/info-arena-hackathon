# Real MAX bot: fill these three values. Leave token empty for a local demo.
BOT_TOKEN=
BOT_USERNAME=
ADMIN_MAX_ID=0
# Required: replace with the output of openssl rand -hex 32. Keep it on updates.
SECRET_KEY=replace-with-at-least-32-random-characters
# Compose fixes this path to the persistent database volume.
DATABASE_URL=sqlite+aiosqlite:////data/arena.db
# Real MAX Mini App: use your public HTTPS URL and configure it in MAX settings.
BASE_APP_URL=http://localhost:8080
WEB_PORT=8080
# Host-only by default. 0.0.0.0 exposes the port publicly; see docs/review.ru.md.
WEB_BIND_ADDRESS=127.0.0.1
BOT_API_URL=https://platform-api2.max.ru
# Usually leave empty: the image includes the MAX root CA. Custom paths need a mount.
MAX_CA_BUNDLE=
# Local demo ONLY: set BOTH true to enable role selection and demo data.
# Keep BOTH false on public servers and when testing real MAX authentication.
DEV_AUTH=false
SEED_DEMO=false
